  "bugs": {
    "url": "https://github.com/ncolon/production-deployment-guides/issues"
  },
  "homepage": "https://github.com/ncolon/production-deployment-guides#readme",
  "dependencies": {
    "cspell": "^5.21.0",
    "linkchecker": "^1.1.0"
  }
}
